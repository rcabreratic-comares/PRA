{
  "manifest_version": 3,
  "name": "Programa de refuerzo de aprendizajes (PRA)",
  "version": "1.0.0",
  "description": "Selecciona medidas de los Programas de Refuerzo (PRA) y rellénalas directamente en Séneca.",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["https://seneca.juntadeandalucia.es/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Programa de refuerzo de aprendizajes (PRA)", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://seneca.juntadeandalucia.es/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
